# LLM Configuration (Groq free tier — get key at console.groq.com)
LLM_API_KEY=your_groq_api_key_here
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Vexa API (get key at cloud.vexa.ai)
VEXA_API_KEY=your_vexa_api_key_here
VEXA_API_BASE=https://api.cloud.vexa.ai

# Meeting Configuration
MEETING_PLATFORM=google_meet
MEETING_ID=abc-defg-hij

# Tracker Settings
POLL_INTERVAL_SECONDS=60
DEVIATION_THRESHOLD=2
ALERT_COOLDOWN_SECONDS=180

# Paste your Google Calendar event description here (or leave blank to enter at runtime)
CALENDAR_DESCRIPTION=

# Meeting Memory Settings
# MEMORY_STORAGE_PATH=~/.meeting_focus_tracker/meeting_history.json
# MEMORY_SIMILARITY_THRESHOLD=0.55

# Google Workspace Integration (all optional — set to true to enable)
ENABLE_GOOGLE_CALENDAR=false
ENABLE_GMAIL_SUMMARY=false
ENABLE_GOOGLE_DRIVE=false
GOOGLE_CREDENTIALS_FILE=credentials.json
GOOGLE_TOKEN_FILE=token.json
GOOGLE_CALENDAR_ID=primary

# Auto Mode — bot auto-joins meetings from your calendar
# AUTO_JOIN_LEAD_MINUTES=2
# CALENDAR_POLL_INTERVAL=30
