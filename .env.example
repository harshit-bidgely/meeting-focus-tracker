# LLM Configuration (Groq free tier — get key at console.groq.com)
LLM_API_KEY=your_groq_api_key_here
LLM_API_BASE=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# Vexa API (get key at cloud.vexa.ai)
VEXA_API_KEY=your_vexa_api_key_here
VEXA_API_BASE=https://api.cloud.vexa.ai

# Meeting Configuration
MEETING_PLATFORM=google_meet
MEETING_ID=abc-defg-hij

# Tracker Settings
POLL_INTERVAL_SECONDS=60
DEVIATION_THRESHOLD=2
ALERT_COOLDOWN_SECONDS=180

# Paste your Google Calendar event description here (or leave blank to enter at runtime)
CALENDAR_DESCRIPTION=

# ── Post-meeting email report (optional) ──────────────────────────────────────
# Leave SMTP_HOST blank to disable email sending (report is still saved locally).
#
# Gmail example:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#   SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=your_app_password   # use an App Password, not your account password
#   EMAIL_SENDER=you@gmail.com
#
# Outlook / Office 365 example:
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_USE_TLS=true
#
# SSL-only providers (port 465):
#   SMTP_USE_TLS=false
#   SMTP_USE_SSL=true
#   SMTP_PORT=465

SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=
# Comma-separated list of recipient addresses
EMAIL_RECIPIENTS=
EMAIL_SUBJECT_PREFIX=Meeting Report

# ── Meeting history store (optional) ──────────────────────────────────────────
# Directory where past meeting reports are saved as JSON (for linked-meeting
# progress tracking).  Leave blank to use the default: .meeting_history/ next
# to this project directory.
HISTORY_DIR=
